# Public canonical site URL used for metadata, canonical links, Open Graph,
# sitemap.xml and robots.txt. Must be the real production origin (no trailing slash).
#
# If unset, the app falls back to the provisional placeholder "https://fahryali.com"
# in src/lib/data/site.ts. Set this to the confirmed domain before deploying.
NEXT_PUBLIC_SITE_URL=https://example.com
